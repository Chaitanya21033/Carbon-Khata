# Copy to .env in the repository root (scripts\setup.ps1 does this). Every variable the API and simulator read.
# ---- database & broker ----
# No Docker? Use DATABASE_URL=embedded, TEST_DATABASE_URL=embedded-test, MQTT_ENABLED=false (setup.ps1 does this automatically).
DATABASE_URL=postgresql+psycopg://carbonkhata:carbonkhata@localhost:5432/carbonkhata
TEST_DATABASE_URL=postgresql+psycopg://carbonkhata:carbonkhata@localhost:5432/carbonkhata_test
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENABLED=true
# ---- auth ----
# Long random string; change it for any shared deployment.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=720
# Dev: the sign-in code is printed in the API console and returned to the sign-in screen. Set false in production.
OTP_DEV_ECHO=true
# SMTP URL for e-mailing sign-in codes (empty = console only), e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
# ---- devices (id:key pairs). The simulator uses the same keys real gateways would. Change for shared deployments. ----
DEVICE_KEYS=sim-vbw:dev-key-vbw,sim-afl:dev-key-afl,sim-cluster:dev-key-cluster,sim-market:dev-key-market
# ---- web ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL printed in QR codes (empty = the address the app is opened on)
VITE_PUBLIC_BASE_URL=
# ---- integrations (empty = mock / fallback adapter; the Data sources drawer shows the status) ----
OPEN_METEO_ENABLED=true
ELECTRICITYMAPS_API_KEY=
SMART_METER_API_URL=
SMART_METER_API_KEY=
IEX_API_URL=
IEX_API_KEY=
KYB_API_URL=
KYB_API_KEY=
# ---- jobs & demo ----
SCHEDULER_ENABLED=true
# Allows the simulator's "Reset all demo data" control. Set false on any non-demo server.
DEMO_RESET_ENABLED=true
STORAGE_DIR=
# ---- simulator ----
API_URL=http://localhost:8000
SIM_CONTROL_PORT=5175
